 <svg
        viewBox="0 0 1440 160"
        preserveAspectRatio="none"
        className="w-full h-full block"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id="waveBack" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stopColor="#312E81" />
            <stop offset="50%" stopColor="#4C1D95" />
            <stop offset="100%" stopColor="#1E1B4B" />
          </linearGradient>
          <linearGradient id="waveMid" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stopColor="#6D28D9" />
            <stop offset="50%" stopColor="#7C3AED" />
            <stop offset="100%" stopColor="#4338CA" />
          </linearGradient>
          <linearGradient id="waveFront" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stopColor="#0E7490" />
            <stop offset="50%" stopColor="#0891B2" />
            <stop offset="100%" stopColor="#155E75" />
          </linearGradient>
          <linearGradient id="crestLine" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stopColor="#FB7185" stopOpacity="0" />
            <stop offset="50%" stopColor="#FDA4AF" stopOpacity="0.9" />
            <stop offset="100%" stopColor="#FB7185" stopOpacity="0" />
          </linearGradient>
        </defs>
 
        {/* back layer - slow, tall */}
        <path fill="url(#waveBack)" opacity="0.55">
          <animate
            attributeName="d"
            dur="14s"
            repeatCount="indefinite"
            values="
              M0,60 C240,110 480,10 720,60 C960,110 1200,10 1440,60 L1440,160 L0,160 Z;
              M0,70 C240,20 480,120 720,70 C960,20 1200,120 1440,70 L1440,160 L0,160 Z;
              M0,60 C240,110 480,10 720,60 C960,110 1200,10 1440,60 L1440,160 L0,160 Z
            "
          />
        </path>
 
        {/* mid layer */}
        <path fill="url(#waveMid)" opacity="0.75">
          <animate
            attributeName="d"
            dur="10s"
            repeatCount="indefinite"
            values="
              M0,95 C220,140 500,50 720,95 C940,140 1220,50 1440,95 L1440,160 L0,160 Z;
              M0,85 C220,45 500,135 720,85 C940,45 1220,135 1440,85 L1440,160 L0,160 Z;
              M0,95 C220,140 500,50 720,95 C940,140 1220,50 1440,95 L1440,160 L0,160 Z
            "
          />
        </path>
 
        {/* front layer with glowing crest */}
        <g>
          <path fill="url(#waveFront)">
            <animate
              attributeName="d"
              dur="7s"
              repeatCount="indefinite"
              values="
                M0,115 C200,150 460,90 720,115 C980,140 1240,90 1440,115 L1440,160 L0,160 Z;
                M0,110 C200,80 460,150 720,110 C980,70 1240,140 1440,110 L1440,160 L0,160 Z;
                M0,115 C200,150 460,90 720,115 C980,140 1240,90 1440,115 L1440,160 L0,160 Z
              "
            />
          </path>
          <path
            fill="none"
            stroke="url(#crestLine)"
            strokeWidth="2"
            strokeLinecap="round"
          >
            <animate
              attributeName="d"
              dur="7s"
              repeatCount="indefinite"
              values="
                M0,115 C200,150 460,90 720,115 C980,140 1240,90 1440,115;
                M0,110 C200,80 460,150 720,110 C980,70 1240,140 1440,110;
                M0,115 C200,150 460,90 720,115 C980,140 1240,90 1440,115
              "
            />
          </path>
        </g>
      </svg>